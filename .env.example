# Copy to .env (never commit .env). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional last-resort fallback when every Gemini model fails (free key: https://console.groq.com/keys)
GROQ_API_KEY=
# Optional overrides (see config/models.yaml)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_DRAFT_MODEL=openai/gpt-oss-120b
# SAAFROUTE_VISION_PROVIDER=gemini_hosted   # gemini_hosted | replay | ollama
# SAAFROUTE_VISION_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it
# SAAFROUTE_DRAFT_PROVIDER=gemini           # gemini | template
# SAAFROUTE_OSRM_URL=https://router.project-osrm.org   # road distances; your own OSRM server, or "off" for straight-line x 1.3
